{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "pad-mix",
    "public": "dashboard",
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/download",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/download.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/downloads/MixPracticeStudio-Windows-x64.zip",
        "destination": "https://github.com/premtodev08710/multiplatform-mixer/releases/latest/download/MixPracticeStudio-Windows-x64.zip",
        "type": 302
      },
      {
        "source": "/downloads/MixPracticeStudio.exe",
        "destination": "https://github.com/premtodev08710/multiplatform-mixer/releases/latest/download/MixPracticeStudio.exe",
        "type": 302
      },
      {
        "source": "/downloads/MixPracticeStudio-Windows.bin",
        "destination": "https://github.com/premtodev08710/multiplatform-mixer/releases/latest/download/MixPracticeStudio-Windows-x64.zip",
        "type": 302
      },
      {
        "source": "/downloads/MixPracticeStudio-macOS.zip",
        "destination": "https://github.com/premtodev08710/multiplatform-mixer/releases/latest/download/MixPracticeStudio-macOS.zip",
        "type": 302
      },
      {
        "source": "/downloads/MixPracticeStudio.pkg",
        "destination": "https://github.com/premtodev08710/multiplatform-mixer/releases/latest/download/MixPracticeStudio.pkg",
        "type": 302
      },
      {
        "source": "/downloads/MixPracticeStudio-macOS.bin",
        "destination": "https://github.com/premtodev08710/multiplatform-mixer/releases/latest/download/MixPracticeStudio.pkg",
        "type": 302
      },
      {
        "source": "/downloads/MixPracticeStudio.apk",
        "destination": "https://github.com/premtodev08710/multiplatform-mixer/releases/latest/download/MixPracticeStudio.apk",
        "type": 302
      },
      {
        "source": "/downloads/MixPracticeStudio-Android.bin",
        "destination": "https://github.com/premtodev08710/multiplatform-mixer/releases/latest/download/MixPracticeStudio.apk",
        "type": 302
      },
      {
        "source": "/downloads/MixPracticeStudio-Android-APK.zip",
        "destination": "https://github.com/premtodev08710/multiplatform-mixer/releases/latest/download/MixPracticeStudio-Android-APK.zip",
        "type": 302
      },
      {
        "source": "/downloads/MixPracticeStudio.ipa",
        "destination": "https://github.com/premtodev08710/multiplatform-mixer/releases/latest/download/MixPracticeStudio.ipa",
        "type": 302
      },
      {
        "source": "/downloads/MixPracticeStudio-iOS.bin",
        "destination": "https://github.com/premtodev08710/multiplatform-mixer/releases/latest/download/MixPracticeStudio.ipa",
        "type": 302
      },
      {
        "source": "/downloads/MixPracticeStudio-iOS-IPA.zip",
        "destination": "https://github.com/premtodev08710/multiplatform-mixer/releases/latest/download/MixPracticeStudio-iOS-IPA.zip",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/home",
        "destination": "/home.html"
      },
      {
        "source": "/maintenance",
        "destination": "/maintenance.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/lite",
        "destination": "/lite.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "downloads/**"
    ]
  }
}
