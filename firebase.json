{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "pad-mix",
    "public": "dashboard",
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/download",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/download.html",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin.html"
      }
    ],
    "headers": [
      {
        "source": "/downloads/MixPracticeStudio-Android.bin",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"MixPracticeStudio.apk\""
          },
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          }
        ]
      },
      {
        "source": "/downloads/MixPracticeStudio-Windows.bin",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"MixPracticeStudio.exe\""
          },
          {
            "key": "Content-Type",
            "value": "application/x-msdownload"
          }
        ]
      },
      {
        "source": "/downloads/MixPracticeStudio-macOS.bin",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"MixPracticeStudio.pkg\""
          },
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          }
        ]
      },
      {
        "source": "/downloads/MixPracticeStudio-iOS.bin",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"MixPracticeStudio.ipa\""
          },
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
